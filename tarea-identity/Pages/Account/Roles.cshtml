@page
@using tarea_identity.Identity;
@model tarea_identity.Pages.Account.RolesModel
@{
    List<MyRole> MyRolees = ViewData["roles"] as List<MyRole>;
}

<div>
    <table>
        @if (MyRolees == null || MyRolees.Count==0)
        {
             <tr>
                    <td>
            <h3>No hay roles</h3>
            </td>
            </tr>
        } else
        {
            @foreach (var item in MyRolees)
            {
                <tr>
                    <td>
                        <strong>@item.Name </strong> @item.Seccion
                    </td>
                </tr>
            }
        }
    </table>

    <form method="post">
        <div>
            <label>Name</label>
            <input asp-for="Rol.Name" />
        </div>

        <div>
            <label>Seccion</label>
            <input asp-for="Rol.Seccion"/>
        </div>

        <button type="submit"> Registrar</button>

    </form>  

</div>